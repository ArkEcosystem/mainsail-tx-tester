{
    "private": true,
    "name": "@mainsail/simple-tx-tester",
    "type": "module",
    "description": "A simple command line utility to create and broadcast transactions.",
    "scripts": {
        "start": "node dist/index.js",
        "message-sign": "node dist/actions/message-sign.js",
        "message-verify": "node dist/actions/message-verify.js",
        "wallet": "node dist/actions/wallet-data.js",
        "validator": "node dist/actions/validator-data.js",
        "fixtures": "node dist/actions/generate-fixtures.js",
        "get-nonce": "node dist/actions/get-nonce.js",
        "build-contract": "node dist/actions/build-contract.js",
        "prepare-contract": "node dist/actions/prepare-contract.js",
        "build": "del dist && tsc",
        "build:watch": "del dist && tsc -w",
        "debug": "node --inspect-brk dist/index.js",
        "clean": "del dist",
        "compile": "./node_modules/typescript/bin/tsc"
    },
    "dependencies": {
        "@mainsail/constants": "link:../packages/constants",
        "@mainsail/container": "link:../packages/container",
        "@mainsail/contracts": "link:../packages/contracts",
        "@mainsail/core": "link:../packages/core",
        "@mainsail/crypto-address-base58": "link:../packages/crypto-address-base58",
        "@mainsail/crypto-address-keccak256": "link:../packages/crypto-address-keccak256",
        "@mainsail/crypto-config": "link:../packages/crypto-config",
        "@mainsail/crypto-key-pair-bls12-381": "link:../packages/crypto-key-pair-bls12-381",
        "@mainsail/crypto-hash-bcrypto": "link:../packages/crypto-hash-bcrypto",
        "@mainsail/crypto-key-pair-ecdsa": "link:../packages/crypto-key-pair-ecdsa",
        "@mainsail/crypto-signature-ecdsa": "link:../packages/crypto-signature-ecdsa",
        "@mainsail/crypto-transaction": "link:../packages/crypto-transaction",
        "@mainsail/crypto-validation": "link:../packages/crypto-validation",
        "@mainsail/crypto-wif": "link:../packages/crypto-wif",
        "@mainsail/evm-contracts": "link:../packages/evm-contracts",
        "@mainsail/kernel": "link:../packages/kernel",
        "@mainsail/serializer": "link:../packages/serializer",
        "@mainsail/transactions": "link:../packages/transactions",
        "@mainsail/utils": "link:../packages/utils",
        "@mainsail/validation": "link:../packages/validation",
        "bip39": "3.1.0",
        "ethers": "6.16.0",
        "fs-extra": "11.3.4",
        "mainsail-network-config": "https://github.com/ArkEcosystem/mainsail-network-config#7479c6d1a3c9dea62a510a6d74ed4df28eb3e08a",
        "reflect-metadata": "0.2.2",
        "solc": "0.8.34",
        "viem": "2.47.17"
    },
    "devDependencies": {
        "@types/eslint": "9.6.1",
        "@types/eslint-config-prettier": "6.11.3",
        "@types/eslint-plugin-prettier": "3.1.3",
        "del-cli": "7.0.0",
        "depcheck": "1.4.7",
        "eslint": "10.2.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.5",
        "eslint-plugin-simple-import-sort": "13.0.0",
        "prettier": "3.8.3",
        "typescript": "6.0.2"
    },
    "engines": {
        "node": ">=24.x"
    }
}
